# ---- LiveKit Cloud (Build plan, free) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=amrutha

# ---- Sarvam (paid from credits) ----
SARVAM_API_KEY=
STT_MODEL=saaras:v4
STT_CLASS=classic                 # classic = sarvam.STT(language="unknown") | realtime = sarvam.STTRealtime(language="auto"); pick in M1 spike
STT_MODE=transcribe               # transcribe | codemix (test for Kanglish)
TTS_MODEL=bulbul:v4-flash
TTS_SAMPLE_RATE=16000             # 8000 for phone (v1.5)
SARVAM_DICT_ID=                   # pronunciation dictionary id (Amrith Sagar, holige, bale ele oota ...)
LIVE_LLM=sarvam-105b-conversations
LIVE_LLM_REASONING=                # sarvam-105b-conversations rejects "none" (only low/medium/high); leave empty = do not send
LIVE_LLM_MAX_TOKENS=250
LIVE_LLM_FALLBACK=                # if tool calling fails in M1: sarvam-105b | deepseekv4.1-flash-1017-interactive | gemma4
TRANSLATE_MODEL=sarvam-translate:v1   # v2 post-call English transcript

# ---- Supabase (free) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=              # only if your project still signs JWTs with the legacy HS256 secret; otherwise JWKS is used
# Use the SESSION POOLER string (Supabase -> Connect). The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
KB_BUCKET=kb-docs                 # uploaded KB documents (no audio is stored)

# ---- Redis (Docker) ----
REDIS_URL=redis://localhost:6379/0

# ---- Post-call + evals (free tiers) ----
GEMINI_API_KEY=
EXTRACT_LLM=gemini-3.8-flash
GROQ_API_KEY=
JUDGE_LLM=openai/gpt-oss-120b
SIM_LLM=openai/gpt-oss-20b

# ---- Embeddings (docs embedded at ingest; one short query embedded per search during calls) ----
EMBED_MODEL=BAAI/bge-small-en-v1.5   # via fastembed (ONNX, no torch), ~130 MB, 384 dims, English (KB + queries are English)
EMBED_DIM=384
SEARCH_MODE=hybrid                # hybrid (default: vector + keyword, RRF) | keyword (fallback / eval comparison)

# ---- Google Sheets ----
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
GOOGLE_SHEET_ID=                  # OPTIONAL: leave empty to skip Sheets (results stay in Supabase + dashboard + Markdown/CSV export)
GOOGLE_CALENDAR_ID=               # business calendar shared with the service account (bookings mirrored here)

# ---- App ----
TENANT_ID=00000000-0000-0000-0000-000000000001
TIMEZONE=Asia/Kolkata
PROMPT_VERSION=v1
FRONTEND_URL=http://localhost:5173
PRICING_FILE=./backend/data/amrith_sagar_pricing.json
AREAS_FILE=./backend/data/areas.json
CAMPAIGN_TYPES_FILE=./backend/data/campaign_types.json

# ---- Call guardrails / limits ----
RING_TIMEOUT_SECONDS=30
RETRY_DELAY_MINUTES=30
WAIT_FOR_PARTICIPANT_SECONDS=45
INBOUND_RATE_LIMIT_PER_IP=3       # per 10 minutes
INBOUND_MAX_CONCURRENT=2

# ---- Razorpay TEST mode only: booking advance payment links (v1) + wallet top-ups (v2 demo) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
