# Frontend env (Vite exposes only VITE_* vars to the browser). Copy to frontend/.env.
# Public values only: never put service keys or secrets here.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=        # anon / publishable key (Auth only; RLS blocks data)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
